{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crest-review",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {"pattern": "brianmills.dev/crest*", "zone_name": "brianmills.dev"}
  ],
  "observability": {"enabled": true},
  "vars": {
    "CREST_BACKEND_ORIGIN": "https://crest-api.brianmills.dev"
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["CrestReviewContainer"]},
    {"tag": "v2", "deleted_classes": ["CrestReviewContainer"]}
  ],
  "upload_source_maps": true
}
