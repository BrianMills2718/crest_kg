# Build context is the repo root (Dockerfile at root, no compose).
#
# The image needs only: requirements.txt, crest_app/, crest_pipeline.py,
# prompts/, web/, and two named corpus files -- see the COPY lines in
# Dockerfile. Everything else here is corpus or generated output.
#
# Patterns stay anchored to the cia_/ufo_ prefixes rather than using a broad
# *.html or *.png, because web/ ships an html file and a broad rule risks
# excluding something the image needs.

.git
.gitattributes
.gitignore

# caches and local environments
__pycache__/
**/__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/

# Corpus and generated output. Directory CONTENTS are excluded, never the
# directories themselves: the Dockerfile copies two files out of these trees,
# and excluding a directory outright makes its re-include unreachable.
cia_documents/**
cia_kg_output/**
cia_ufo_output/**
cia_ufo_pdfs/**
cia_ufo_documents/**

# Generated artifacts at the context root
cia_kg_*.json
cia_knowledge_graph*.html
cia_knowledge_graph*.png
ufo_knowledge_graph*.html
*.ipynb

# local secrets never belong in a build context
.env
.env.*

# sanctioned worktrees are checkouts of this same repo
worktrees/

# Re-includes go last so they win regardless of matcher semantics: both files
# below appear in COPY lines and must reach the build context.
!.env.example
!cia_documents/disinformation_complete_20250517_002848.json
!cia_kg_output/validated_5_documents_relationship_binding_v2.json
